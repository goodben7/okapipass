{#
  PDF billet agence (Dompdf) — aligné aperçu front okapi-pass-v2.
  Variables : ticket, offer, agency, qrCode, issuedAt, total,
              originLabel, destinationLabel, companyName (AgencyTicketPdfGenerator).
#}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 0; }
        * { box-sizing: border-box; }
        body {
            font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            color: #0f172a;
        }
        .container {
            width: 450px;
            min-height: 650px;
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
        }
        .top-border {
            width: 100%;
            height: 6px;
            line-height: 0;
            font-size: 0;
        }
        .top-border td { height: 6px; padding: 0; margin: 0; border: 0; }
        .content { padding: 24px 28px 20px; }

        .agency-name {
            font-size: 24px;
            font-weight: bold;
            color: #0f172a;
            line-height: 1.2;
            margin: 0 0 12px;
        }
        .ref-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            margin: 0 0 3px;
        }
        .ref-value {
            font-size: 20px;
            font-weight: bold;
            color: #2563eb;
            letter-spacing: 0.4px;
            margin: 0 0 3px;
        }
        .subtitle {
            font-size: 11px;
            color: #94a3b8;
            margin: 0 0 14px;
        }

        .qr-wrap {
            width: 100%;
            text-align: center;
            margin: 6px 0 0;
        }
        .qr-box {
            border: 1px solid #e2e8f0;
            padding: 14px;
            background: #ffffff;
        }
        .qr-image { width: 170px; height: 170px; }

        .badge-wrap {
            width: 100%;
            text-align: center;
            margin: 14px 0 0;
        }
        .ref-badge {
            display: inline-block;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 7px 20px;
        }
        .ref-badge .mini-label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            margin: 0 0 2px;
        }
        .ref-badge .mini-value {
            font-size: 17px;
            font-weight: bold;
            color: #2563eb;
            letter-spacing: 0.4px;
        }

        .info-table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
        }
        .info-table td {
            width: 50%;
            padding: 0 8px 13px 0;
            vertical-align: top;
        }
        .info-table td:last-child { padding-right: 0; padding-left: 8px; }
        .label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            margin: 0 0 3px;
        }
        .value {
            font-size: 14px;
            font-weight: bold;
            color: #0f172a;
            line-height: 1.25;
        }
        .value-accent { color: #f59e0b; }
        .sub-value {
            font-size: 10px;
            color: #94a3b8;
            margin-top: 2px;
            line-height: 1.3;
        }

        .footer {
            margin-top: 8px;
            border-top: 1px solid #e2e8f0;
            padding-top: 12px;
        }
        .footer-table { width: 100%; border-collapse: collapse; }
        .footer-table td { vertical-align: middle; padding: 0; }
        .footer-note {
            font-size: 10px;
            color: #94a3b8;
            line-height: 1.4;
        }
        .status-badge {
            border: 1px solid #10b981;
            padding: 4px 11px;
            color: #059669;
            font-size: 11px;
            font-weight: bold;
            background-color: #ecfdf5;
            white-space: nowrap;
        }
    </style>
</head>
<body>
{% set ref = (ticket.reference|default(ticket.id))|upper %}
{% set status = ticket.status|default('ISSUED')|upper %}
{% set statusLabel = 'Valide' %}
{% if status == 'CANCELLED' or status == 'REFUNDED' %}
    {% set statusLabel = 'Annulé' %}
{% elseif status == 'BOARDED' %}
    {% set statusLabel = 'Embarqué' %}
{% endif %}
{% set origin = originLabel|default(offer ? offer.origin : null)|default('—') %}
{% set destination = destinationLabel|default(offer ? offer.destination : null)|default('—') %}
{% set ticketPrice = ticket.ticketPrice|default(0) %}
{% set passPrice = ticket.passPrice|default(0) %}
{% set months = {
    1: 'janv.', 2: 'févr.', 3: 'mars', 4: 'avr.', 5: 'mai', 6: 'juin',
    7: 'juil.', 8: 'août', 9: 'sept.', 10: 'oct.', 11: 'nov.', 12: 'déc.'
} %}
{% if ticket.travelDate %}
    {% set travelDateLabel = ticket.travelDate|date('j') ~ ' ' ~ months[ticket.travelDate|date('n')] ~ ' ' ~ ticket.travelDate|date('Y') %}
{% else %}
    {% set travelDateLabel = '—' %}
{% endif %}
{% if issuedAt %}
    {% set issuedLabel = issuedAt|date('j') ~ ' ' ~ months[issuedAt|date('n')] ~ ' ' ~ issuedAt|date('Y') %}
{% else %}
    {% set issuedLabel = '—' %}
{% endif %}

<div class="container">
    <table class="top-border" cellpadding="0" cellspacing="0">
        <tr>
            <td style="width:33.33%; background-color:#2563eb;">&nbsp;</td>
            <td style="width:33.33%; background-color:#fbbf24;">&nbsp;</td>
            <td style="width:33.34%; background-color:#ef4444;">&nbsp;</td>
        </tr>
    </table>

    <div class="content">
        <div class="agency-name">{{ agency.name|default(companyName|default('Agence partenaire')) }}</div>

        <div class="ref-label">N° billet</div>
        <div class="ref-value">{{ ref }}</div>
        <div class="subtitle">Billet de voyage</div>

        <div class="qr-wrap">
            <table align="center" cellpadding="0" cellspacing="0" class="qr-box">
                <tr>
                    <td align="center">
                        <img src="{{ qrCode }}" class="qr-image" alt="QR {{ ref }}">
                    </td>
                </tr>
            </table>
        </div>

        <div class="badge-wrap">
            <div class="ref-badge">
                <div class="mini-label">Numéro de billet</div>
                <div class="mini-value">{{ ref }}</div>
            </div>
        </div>

        <table class="info-table" cellpadding="0" cellspacing="0">
            <tr>
                <td>
                    <div class="label">Passager</div>
                    <div class="value">{{ ticket.passengerName|default('N/A') }}</div>
                    {% if ticket.passengerId %}
                        <div class="sub-value">{{ ticket.passengerId }}</div>
                    {% endif %}
                </td>
                <td>
                    <div class="label">Siège</div>
                    <div class="value value-accent">{{ ticket.seatNumber|default('—') }}</div>
                    <div class="sub-value">{{ origin }} &#8594; {{ destination }}</div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Départ</div>
                    <div class="value">{{ origin }}</div>
                </td>
                <td>
                    <div class="label">Arrivée</div>
                    <div class="value">{{ destination }}</div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Date voyage</div>
                    <div class="value">{{ travelDateLabel }}</div>
                </td>
                <td>
                    <div class="label">Heure départ</div>
                    <div class="value">{{ offer ? (offer.departureTime|default('—')) : '—' }}</div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Montant</div>
                    <div class="value">{{ total|number_format(0, '.', ' ') }} {{ ticket.currency|default('CDF') }}</div>
                    <div class="sub-value">Billet {{ ticketPrice|number_format(0, '.', ' ') }} {{ ticket.currency|default('CDF') }} &#183; FPT {{ passPrice|number_format(0, '.', ' ') }} {{ ticket.currency|default('CDF') }}</div>
                </td>
                <td>
                    <div class="label">Émis le</div>
                    <div class="value">{{ issuedLabel }}</div>
                </td>
            </tr>
        </table>

        <div class="footer">
            <table class="footer-table" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="footer-note">
                        Présentez ce billet à l'embarquement.
                    </td>
                    <td align="right" style="width: 110px;">
                        <span class="status-badge">&#9679; {{ statusLabel }}</span>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
</body>
</html>
