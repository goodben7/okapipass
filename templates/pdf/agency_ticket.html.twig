<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 0; }
        * { box-sizing: border-box; }
        body {
            font-family: Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #0f172a;
        }
        .container {
            width: 450px;
            height: 680px;
            background-color: #0f172a;
            position: relative;
            color: #ffffff;
        }
        .top-border { width: 100%; height: 5px; overflow: hidden; }
        .border-item { float: left; height: 5px; width: 33.33%; }
        .content { padding: 28px 30px 24px; }

        .header { margin-bottom: 18px; }
        .company-name {
            font-size: 22px;
            font-weight: bold;
            line-height: 1.15;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .ticket-type {
            margin-top: 4px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: rgba(255, 255, 255, 0.55);
        }

        .route-card {
            background-color: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 18px;
        }
        .route-label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 8px;
        }
        .route-row { width: 100%; border-collapse: collapse; }
        .route-row td { vertical-align: middle; padding: 0; }
        .route-city {
            font-size: 16px;
            font-weight: bold;
            line-height: 1.2;
            color: #ffffff;
        }
        .route-arrow {
            width: 36px;
            text-align: center;
            font-size: 18px;
            color: #fbbf24;
            font-weight: bold;
        }
        .route-subtitle {
            margin-top: 8px;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.65);
        }

        .qr-section { text-align: center; margin-bottom: 14px; }
        .qr-box {
            background-color: #ffffff;
            padding: 16px;
            border-radius: 18px;
            display: inline-block;
        }
        .qr-image { width: 160px; height: 160px; }
        .ref-badge {
            margin-top: 12px;
            background-color: rgba(251, 191, 36, 0.12);
            border: 1px solid rgba(251, 191, 36, 0.35);
            padding: 8px 18px;
            border-radius: 999px;
            color: #fbbf24;
            font-size: 16px;
            font-weight: bold;
            display: inline-block;
            letter-spacing: 0.5px;
        }

        .info-table { width: 100%; border-collapse: collapse; margin-top: 6px; }
        .info-table td {
            width: 50%;
            padding: 0 0 14px;
            vertical-align: top;
        }
        .label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 4px;
        }
        .value {
            font-size: 15px;
            font-weight: bold;
            color: #ffffff;
            line-height: 1.25;
        }
        .value-accent { color: #fbbf24; }
        .value-muted { font-size: 12px; font-weight: normal; color: rgba(255, 255, 255, 0.75); }

        .divider {
            height: 1px;
            background-color: rgba(255, 255, 255, 0.12);
            margin: 4px 0 14px;
        }

        .footer {
            position: absolute;
            bottom: 24px;
            left: 30px;
            right: 30px;
        }
        .footer-table { width: 100%; border-collapse: collapse; }
        .footer-table td { vertical-align: bottom; padding: 0; }
        .amount-value { font-size: 18px; font-weight: bold; color: #ffffff; }
        .issued-at { font-size: 10px; color: rgba(255, 255, 255, 0.45); margin-top: 3px; }
        .status-badge {
            float: right;
            border: 1px solid #34d399;
            padding: 6px 12px;
            border-radius: 999px;
            color: #34d399;
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            background-color: rgba(52, 211, 153, 0.1);
        }
    </style>
</head>
<body>
<div class="container">
    <div class="top-border">
        <div class="border-item" style="background-color: #1d4ed8;"></div>
        <div class="border-item" style="background-color: #fbbf24;"></div>
        <div class="border-item" style="background-color: #ef4444;"></div>
    </div>

    <div class="content">
        <div class="header">
            <div class="company-name">{{ companyName }}</div>
            <div class="ticket-type">Billet voyage</div>
        </div>

        <div class="route-card">
            <div class="route-label">Itinéraire</div>
            <table class="route-row">
                <tr>
                    <td style="width: 42%;">
                        <div class="route-city">{{ originLabel }}</div>
                    </td>
                    <td class="route-arrow">→</td>
                    <td style="width: 42%; text-align: right;">
                        <div class="route-city">{{ destinationLabel }}</div>
                    </td>
                </tr>
            </table>
            {% if routeLabel %}
                <div class="route-subtitle">{{ routeLabel }}{% if offer.departureTime %} · Départ {{ offer.departureTime }}{% endif %}</div>
            {% elseif offer.departureTime %}
                <div class="route-subtitle">Départ {{ offer.departureTime }}</div>
            {% endif %}
        </div>

        <div class="qr-section">
            <div class="qr-box">
                <img src="{{ qrCode }}" class="qr-image" alt="QR">
            </div>
            <div>
                <span class="ref-badge">{{ ticket.reference|upper }}</span>
            </div>
        </div>

        <table class="info-table">
            <tr>
                <td>
                    <div class="label">Passager</div>
                    <div class="value">{{ ticket.passengerName }}</div>
                </td>
                <td>
                    <div class="label">Siège</div>
                    <div class="value value-accent">{{ ticket.seatNumber|default('—') }}</div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Date du voyage</div>
                    <div class="value">{{ ticket.travelDate|date('d/m/Y') }}</div>
                </td>
                <td>
                    <div class="label">Heure de départ</div>
                    <div class="value">{{ offer.departureTime|default('—') }}</div>
                </td>
            </tr>
            {% if transport %}
            <tr>
                <td colspan="2">
                    <div class="label">Véhicule</div>
                    <div class="value value-muted">{{ transport.label }}{% if transport.plateNumber %} · {{ transport.plateNumber }}{% endif %}</div>
                </td>
            </tr>
            {% endif %}
        </table>

        <div class="divider"></div>

        <div class="footer">
            <div class="status-badge">● Émis</div>
            <table class="footer-table">
                <tr>
                    <td>
                        <div class="label">Montant total</div>
                        <div class="amount-value">{{ total|number_format(0, '.', ' ') }} {{ ticket.currency }}</div>
                        <div class="issued-at">Émis le {{ issuedAt|date('d/m/Y à H:i') }}</div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
</body>
</html>
