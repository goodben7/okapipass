{#
  PDF billet agence (Dompdf) — aligné aperçu front okapi-pass-v2.
  Variables : ticket, offer, agency, qrCode, issuedAt, total,
              + originLabel / destinationLabel / companyName (AgencyTicketPdfGenerator).
#}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 0; }
        body {
            font-family: Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }
        .container {
            width: 450px;
            height: 680px;
            background-color: #ffffff;
            position: relative;
            color: #0f172a;
            border: 1px solid #e2e8f0;
        }
        .top-border { width: 100%; height: 6px; }
        .border-item { float: left; height: 6px; width: 33.33%; }
        .content { padding: 26px 30px 30px; }

        .agency-name {
            font-size: 26px;
            font-weight: bold;
            color: #0f172a;
            line-height: 1.15;
            margin: 0 0 14px;
        }
        .ref-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .ref-value {
            font-size: 20px;
            font-weight: bold;
            color: #2563eb;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
            word-wrap: break-word;
        }
        .subtitle {
            font-size: 11px;
            color: #94a3b8;
            margin-bottom: 12px;
        }

        .qr-section { text-align: center; margin-top: 8px; }
        .qr-box {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            padding: 18px;
            border-radius: 18px;
            display: inline-block;
        }
        .qr-image { width: 180px; height: 180px; }

        .ref-container { text-align: center; margin-top: 16px; }
        .ref-badge {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 8px 22px;
            border-radius: 15px;
            display: inline-block;
        }
        .ref-badge .mini-label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            margin-bottom: 2px;
        }
        .ref-badge .mini-value {
            font-size: 18px;
            font-weight: bold;
            color: #2563eb;
            letter-spacing: 0.5px;
        }

        .info-table {
            width: 100%;
            margin-top: 22px;
            border-collapse: collapse;
        }
        .info-table td {
            width: 50%;
            padding-bottom: 14px;
            vertical-align: top;
        }
        .label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .value {
            font-size: 15px;
            font-weight: bold;
            color: #0f172a;
        }
        .value-accent { color: #f59e0b; }
        .sub-value {
            font-size: 10px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .footer {
            position: absolute;
            bottom: 22px;
            left: 30px;
            right: 30px;
            border-top: 1px solid #e2e8f0;
            padding-top: 12px;
        }
        .status-badge {
            float: right;
            border: 1px solid #10b981;
            padding: 5px 12px;
            border-radius: 15px;
            color: #059669;
            font-size: 11px;
            font-weight: bold;
            background-color: #ecfdf5;
        }
        .footer-note {
            font-size: 10px;
            color: #94a3b8;
            width: 65%;
            line-height: 1.4;
        }
    </style>
</head>
<body>
{% set ref = (ticket.reference|default(ticket.id))|upper %}
{% set status = ticket.status|default('ISSUED')|upper %}
{% set statusLabel = 'Valide' %}
{% if status == 'CANCELLED' or status == 'REFUNDED' %}
    {% set statusLabel = 'Annulé' %}
{% elseif status == 'BOARDED' %}
    {% set statusLabel = 'Embarqué' %}
{% endif %}
{% set origin = originLabel|default(offer.origin|default('—')) %}
{% set destination = destinationLabel|default(offer.destination|default('—')) %}

<div class="container">
    <div class="top-border">
        <div class="border-item" style="background-color: #2563eb;"></div>
        <div class="border-item" style="background-color: #fbbf24;"></div>
        <div class="border-item" style="background-color: #ef4444;"></div>
    </div>

    <div class="content">
        <div class="agency-name">{{ agency.name|default(companyName|default('Agence partenaire')) }}</div>

        <div class="ref-label">N° billet</div>
        <div class="ref-value">{{ ref }}</div>
        <div class="subtitle">Billet de voyage</div>

        <div class="qr-section">
            <div class="qr-box">
                <img src="{{ qrCode }}" class="qr-image" alt="QR {{ ref }}">
            </div>
        </div>

        <div class="ref-container">
            <div class="ref-badge">
                <div class="mini-label">Numéro de billet</div>
                <div class="mini-value">{{ ref }}</div>
            </div>
        </div>

        <table class="info-table">
            <tr>
                <td>
                    <div class="label">Passager</div>
                    <div class="value">{{ ticket.passengerName|default('N/A') }}</div>
                    {% if ticket.passengerId %}
                        <div class="sub-value">{{ ticket.passengerId }}</div>
                    {% endif %}
                </td>
                <td>
                    <div class="label">Siège</div>
                    <div class="value value-accent">{{ ticket.seatNumber|default('—') }}</div>
                    {% if offer and offer.label %}
                        <div class="sub-value">{{ offer.label }}</div>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Départ</div>
                    <div class="value">{{ origin }}</div>
                </td>
                <td>
                    <div class="label">Arrivée</div>
                    <div class="value">{{ destination }}</div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Date voyage</div>
                    <div class="value">
                        {% if ticket.travelDate %}
                            {{ ticket.travelDate|date('d/m/Y') }}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div class="label">Heure départ</div>
                    <div class="value">{{ offer.departureTime|default('—') }}</div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Montant</div>
                    <div class="value">{{ total|number_format(0, '.', ' ') }} {{ ticket.currency|default('CDF') }}</div>
                </td>
                <td>
                    <div class="label">Émis le</div>
                    <div class="value">{{ issuedAt|date('d/m/Y') }}</div>
                </td>
            </tr>
        </table>

        <div class="footer">
            <div class="status-badge">
                <span style="font-size: 14px;">●</span> {{ statusLabel }}
            </div>
            <div class="footer-note">
                Présentez ce billet à l’embarquement.
                {% if agency and agency.phone %} · {{ agency.phone }}{% endif %}
            </div>
        </div>
    </div>
</div>
</body>
</html>
