{#
  PDF Pass FPT / GoPass (Dompdf) — aligné carte web OkapiFPT.
  Variables : ticket, qrCode, issuedAt, expiresAt,
              passLabel, transportLabel, departureLabel, arrivalLabel.
#}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 0; }
        * { box-sizing: border-box; }
        body {
            font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #ffffff;
        }
        .card {
            position: relative;
            width: 450px;
            min-height: 650px;
            background-color: #1d4ed8;
            color: #ffffff;
            overflow: hidden;
        }
        .glow {
            position: absolute;
            border-radius: 50%;
            background-color: rgba(96, 165, 250, 0.22);
        }
        .glow-tr { top: -70px; right: -60px; width: 200px; height: 200px; }
        .glow-bl { bottom: -50px; left: -40px; width: 160px; height: 160px; background-color: rgba(37, 99, 235, 0.45); }

        .top-border {
            width: 100%;
            height: 4px;
            line-height: 0;
            font-size: 0;
            position: relative;
            z-index: 2;
        }
        .top-border td { height: 4px; padding: 0; margin: 0; border: 0; }
        .content {
            position: relative;
            z-index: 2;
            padding: 20px 24px 18px;
        }

        .header-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
        .header-table td { vertical-align: middle; padding: 0; }
        .org-name {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(191, 219, 254, 0.9);
            margin: 0 0 4px;
        }
        .brand {
            font-size: 26px;
            font-weight: bold;
            color: #ffffff;
            margin: 0;
            line-height: 1.1;
        }
        .brand-accent { color: #facc15; }
        .shield {
            width: 36px;
            height: 36px;
            background-color: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.28);
            text-align: center;
            line-height: 36px;
            font-size: 14px;
            color: #ffffff;
            border-radius: 18px;
        }

        .qr-wrap { width: 100%; text-align: center; margin: 4px 0 0; }
        .qr-box {
            background-color: #ffffff;
            padding: 12px;
            border-radius: 12px;
        }
        .qr-image { width: 170px; height: 170px; }

        .ref-wrap { width: 100%; text-align: center; margin: 12px 0 16px; }
        .ref-badge {
            display: inline-block;
            background-color: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.28);
            padding: 7px 16px;
            border-radius: 20px;
        }
        .ref-hash {
            color: #facc15;
            font-size: 13px;
            font-weight: bold;
            vertical-align: middle;
        }
        .ref-value {
            color: #ffffff;
            font-size: 15px;
            font-weight: bold;
            letter-spacing: 2.2px;
            vertical-align: middle;
            padding-left: 5px;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2px;
        }
        .info-table td {
            width: 50%;
            padding: 0 8px 12px 0;
            vertical-align: top;
        }
        .info-table td:last-child { padding-right: 0; padding-left: 8px; }
        .label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: rgba(191, 219, 254, 0.95);
            margin: 0 0 3px;
        }
        .value {
            font-size: 14px;
            font-weight: bold;
            color: #ffffff;
            line-height: 1.25;
        }
        .value-yellow { color: #facc15; }
        .sub-value {
            font-size: 10px;
            color: rgba(255, 255, 255, 0.55);
            margin-top: 2px;
            line-height: 1.3;
        }

        .footer {
            margin-top: 4px;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            padding-top: 12px;
        }
        .footer-table { width: 100%; border-collapse: collapse; }
        .footer-table td { vertical-align: middle; padding: 0; }
        .status-badge {
            border: 1px solid rgba(74, 222, 128, 0.5);
            background-color: rgba(34, 197, 94, 0.2);
            color: #bbf7d0;
            font-size: 10px;
            font-weight: bold;
            padding: 5px 11px;
            white-space: nowrap;
            border-radius: 12px;
        }
    </style>
</head>
<body>
{% set ref = (ticket.uniqueReference|default(ticket.id))|upper %}
{% set passLabel = passLabel|default(ticket.goPass ? ticket.goPass.label : 'Routier') %}
{% set transportLabel = transportLabel|default('Routier') %}
{% set departure = departureLabel|default(ticket.departure ? ticket.departure.label : '—') %}
{% set arrival = arrivalLabel|default(ticket.arrival ? ticket.arrival.label : '—') %}

<div class="card">
    <div class="glow glow-tr"></div>
    <div class="glow glow-bl"></div>

    <table class="top-border" cellpadding="0" cellspacing="0">
        <tr>
            <td style="width:33.33%; background-color:#facc15;">&nbsp;</td>
            <td style="width:33.33%; background-color:#ef4444;">&nbsp;</td>
            <td style="width:33.34%; background-color:#1e40af;">&nbsp;</td>
        </tr>
    </table>

    <div class="content">
        <table class="header-table" cellpadding="0" cellspacing="0">
            <tr>
                <td>
                    <div class="org-name">Office National du Tourisme</div>
                    <div class="brand">Okapi<span class="brand-accent">FPT</span></div>
                </td>
                <td align="right" style="width: 44px;">
                    <div class="shield">&#10003;</div>
                </td>
            </tr>
        </table>

        <div class="qr-wrap">
            <table align="center" cellpadding="0" cellspacing="0" class="qr-box">
                <tr>
                    <td align="center">
                        <img src="{{ qrCode }}" class="qr-image" alt="QR {{ ref }}">
                    </td>
                </tr>
            </table>
        </div>

        <div class="ref-wrap">
            <div class="ref-badge">
                <span class="ref-hash">#</span><span class="ref-value">{{ ref }}</span>
            </div>
        </div>

        <table class="info-table" cellpadding="0" cellspacing="0">
            <tr>
                <td>
                    <div class="label">Titulaire</div>
                    <div class="value">{{ ticket.displayName|default('N/A') }}</div>
                </td>
                <td>
                    <div class="label">Type</div>
                    <div class="value value-yellow">{{ passLabel }}</div>
                    {% if transportLabel and transportLabel != passLabel %}
                        <div class="sub-value">{{ transportLabel }}</div>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Départ</div>
                    <div class="value">{{ departure }}</div>
                </td>
                <td>
                    <div class="label">Arrivée</div>
                    <div class="value">{{ arrival }}</div>
                </td>
            </tr>
        </table>

        <div class="footer">
            <table class="footer-table" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="width:34%;">
                        <div class="label">Émis le</div>
                        <div class="value" style="font-size:12px;">{{ issuedAt|date('d/m/Y') }}</div>
                    </td>
                    <td style="width:34%;">
                        <div class="label">Expire le</div>
                        <div class="value" style="font-size:12px;">{{ expiresAt|date('d/m/Y') }}</div>
                    </td>
                    <td align="right" style="width:32%;">
                        <span class="status-badge">&#9679; Valide</span>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
</body>
</html>
