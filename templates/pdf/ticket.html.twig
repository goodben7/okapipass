{#
  PDF Pass FPT / GoPass (Dompdf) — miroir exact du TicketCard React OkapiFPT.
  Variables : ticket, qrCode, issuedAt, expiresAt,
              passLabel, transportLabel, departureLabel, arrivalLabel.
#}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 0; }
        * { box-sizing: border-box; }
        body {
            font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #ffffff;
        }
        .card {
            position: relative;
            width: 450px;
            min-height: 650px;
            /* Dompdf: solid approx of linear-gradient(135deg, #003D99, #007FFF, #0099E6) */
            background-color: #007FFF;
            color: #ffffff;
            overflow: hidden;
        }
        .glow {
            position: absolute;
            border-radius: 50%;
        }
        .glow-tr {
            top: -64px;
            right: -64px;
            width: 192px;
            height: 192px;
            background-color: rgba(255, 255, 255, 0.05);
        }
        .glow-bl {
            bottom: -40px;
            left: -40px;
            width: 144px;
            height: 144px;
            background-color: rgba(247, 214, 24, 0.10);
        }

        .top-border {
            width: 100%;
            height: 4px;
            line-height: 0;
            font-size: 0;
            position: relative;
            z-index: 2;
        }
        .top-border td { height: 4px; padding: 0; margin: 0; border: 0; }
        .content {
            position: relative;
            z-index: 2;
            padding: 20px 24px 18px;
        }

        .header-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
        .header-table td { vertical-align: middle; padding: 0; }
        .org-name {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            color: rgba(255, 255, 255, 0.50);
            margin: 0 0 3px;
        }
        .brand {
            font-size: 20px;
            font-weight: bold;
            color: #ffffff;
            margin: 0;
            line-height: 1.15;
        }
        .brand-accent { color: #F7D618; }
        .shield {
            width: 36px;
            height: 36px;
            background-color: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.20);
            text-align: center;
            line-height: 36px;
            font-size: 14px;
            color: #ffffff;
        }

        .qr-wrap { width: 100%; text-align: center; margin: 0 0 14px; }
        .qr-box {
            background-color: #ffffff;
            padding: 12px;
        }
        .qr-image { width: 160px; height: 160px; }

        .ref-wrap { width: 100%; text-align: center; margin: 0 0 18px; }
        .ref-badge {
            display: inline-block;
            background-color: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.22);
            padding: 9px 16px;
        }
        .ref-hash {
            color: #F7D618;
            font-size: 13px;
            font-weight: bold;
            vertical-align: middle;
        }
        .ref-value {
            color: #ffffff;
            font-size: 15px;
            font-weight: bold;
            letter-spacing: 2.5px;
            vertical-align: middle;
            padding-left: 6px;
            font-family: DejaVu Sans Mono, monospace;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2px;
        }
        .info-table td {
            width: 50%;
            padding: 0 10px 12px 0;
            vertical-align: top;
        }
        .info-table td:last-child { padding-right: 0; padding-left: 10px; }
        .label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.50);
            margin: 0 0 4px;
        }
        .value {
            font-size: 13px;
            font-weight: bold;
            color: #ffffff;
            line-height: 1.25;
        }
        .value-sm {
            font-size: 12px;
            font-weight: bold;
            color: #ffffff;
            line-height: 1.25;
        }
        .value-yellow { color: #F7D618; }
        .sub-value {
            font-size: 10px;
            color: rgba(255, 255, 255, 0.55);
            margin-top: 2px;
            line-height: 1.3;
        }

        .footer {
            margin-top: 6px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            padding-top: 12px;
        }
        .footer-table { width: 100%; border-collapse: collapse; }
        .footer-table td { vertical-align: middle; padding: 0; }
        .status-badge {
            border: 1px solid rgba(74, 222, 128, 0.30);
            background-color: rgba(34, 197, 94, 0.20);
            color: #86efac;
            font-size: 10px;
            font-weight: bold;
            padding: 5px 10px;
            white-space: nowrap;
        }
    </style>
</head>
<body>
{% set ref = (ticket.uniqueReference|default(ticket.id))|upper %}
{% set passLabel = passLabel|default(ticket.goPass ? ticket.goPass.label : 'Routier') %}
{% set transportLabel = transportLabel|default('Routier') %}
{% set departure = departureLabel|default(ticket.departure ? ticket.departure.label : '—') %}
{% set arrival = arrivalLabel|default(ticket.arrival ? ticket.arrival.label : '—') %}
{% set holderId = ticket.identifier|default('') %}

<div class="card">
    <div class="glow glow-tr"></div>
    <div class="glow glow-bl"></div>

    {# Barre tricolore : #007FFF | #F7D618 | #CE1021 #}
    <table class="top-border" cellpadding="0" cellspacing="0">
        <tr>
            <td style="width:33.33%; background-color:#007FFF;">&nbsp;</td>
            <td style="width:33.33%; background-color:#F7D618;">&nbsp;</td>
            <td style="width:33.34%; background-color:#CE1021;">&nbsp;</td>
        </tr>
    </table>

    <div class="content">
        <table class="header-table" cellpadding="0" cellspacing="0">
            <tr>
                <td>
                    <div class="org-name">Office National du Tourisme</div>
                    <div class="brand">Okapi<span class="brand-accent">FPT</span></div>
                </td>
                <td align="right" style="width: 44px;">
                    <div class="shield">&#10003;</div>
                </td>
            </tr>
        </table>

        <div class="qr-wrap">
            <table align="center" cellpadding="0" cellspacing="0" class="qr-box">
                <tr>
                    <td align="center">
                        <img src="{{ qrCode }}" class="qr-image" alt="QR {{ ref }}">
                    </td>
                </tr>
            </table>
        </div>

        <div class="ref-wrap">
            <div class="ref-badge">
                <span class="ref-hash">#</span><span class="ref-value">{{ ref }}</span>
            </div>
        </div>

        <table class="info-table" cellpadding="0" cellspacing="0">
            <tr>
                <td>
                    <div class="label">Titulaire</div>
                    <div class="value">{{ ticket.displayName|default('N/A') }}</div>
                    {% if holderId %}
                        <div class="sub-value">{{ holderId }}</div>
                    {% endif %}
                </td>
                <td>
                    <div class="label">Type</div>
                    <div class="value value-yellow">{{ passLabel }}</div>
                    <div class="sub-value">{{ transportLabel }}</div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="label">Départ</div>
                    <div class="value-sm">{{ departure }}</div>
                </td>
                <td>
                    <div class="label">Arrivée</div>
                    <div class="value-sm">{{ arrival }}</div>
                </td>
            </tr>
        </table>

        <div class="footer">
            <table class="footer-table" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="width:34%;">
                        <div class="label">Émis le</div>
                        <div class="value" style="font-size:12px;">{{ issuedAt|date('d/m/Y') }}</div>
                    </td>
                    <td style="width:34%;">
                        <div class="label">Expire le</div>
                        <div class="value" style="font-size:12px;">{{ expiresAt|date('d/m/Y') }}</div>
                    </td>
                    <td align="right" style="width:32%;">
                        <span class="status-badge">&#9679; Valide</span>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
</body>
</html>
