###> OkapiPass VPS / staging (MySQL) ###
# cp .env.vps.dist .env.vps && nano .env.vps
# Puis: docker compose -f docker-compose.vps.yml --env-file .env.vps up -d --build

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_generate_with_openssl_rand_hex_32
APP_SHARE_DIR=var/share

DEFAULT_URI=https://api.ont.digisafrica.tech

### MySQL (service Docker "mysql") — PAS Postgres
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=okapipass
MYSQL_USER=okapi
MYSQL_PASSWORD=change_db_password
# Host = nom du service compose ("mysql"), pas 127.0.0.1
DATABASE_URL="mysql://okapi:change_db_password@mysql:3306/okapipass?serverVersion=8.0&charset=utf8mb4"

### JWT (généré auto au boot si absent — laisser PASSPHRASE vide)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

### CORS + proxy
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|.*\.digisafrica\.tech|.*\.vercel\.app)(:[0-9]+)?$'

### Mail
MAILER_DSN=null://null
MAILER_SENDER=noreply@digisafrica.tech
MAILER_SENDER_NAME=OkapiPass

### FlexPay
FLEXPAY_MERCHANT_ID=changeme
FLEXPAY_TOKEN=changeme

### UltraMsg / WhatsApp
ULTRAMSG_API_KEY=changeme
ULTRAMSG_INSTANCE_ID=changeme
ULTRAMSG_WEBHOOK_KEY=changeme

### Agency
AGENCY_PASS_VALIDATE_STRICT=0

# Async Symfony Messenger (MySQL doctrine transport — PAS Redis/AMQP pour l’instant)
# Consommé par le service Docker "worker"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< OkapiPass VPS / staging ###
