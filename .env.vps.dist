###> OkapiPass VPS / staging ###
# Copy to .env.vps on the server and fill secrets:
#   cp .env.vps.dist .env.vps

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_to_a_long_random_string

DEFAULT_URI=https://api.ont.digisafrica.tech

### Database (Docker service "mysql")
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=okapipass
MYSQL_USER=okapi
MYSQL_PASSWORD=change_db_password
DATABASE_URL="mysql://okapi:change_db_password@mysql:3306/okapipass?serverVersion=8.0&charset=utf8mb4"

### JWT (keys auto-generated in container if missing)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

### Behind host Nginx TLS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|.*\.digisafrica\.tech|.*\.vercel\.app)(:[0-9]+)?$'
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto,x-forwarded-port,x-forwarded-prefix

### Mail (null or mailpit if profile enabled)
MAILER_DSN=null://null
MAILER_SENDER=noreply@digisafrica.tech
MAILER_SENDER_NAME=OkapiPass

### Integrations (fill as needed)
FLEXPAY_MERCHANT_ID=changeme
FLEXPAY_TOKEN=changeme
ULTRAMSG_API_KEY=changeme
ULTRAMSG_INSTANCE_ID=changeme

AGENCY_PASS_VALIDATE_STRICT=0

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< OkapiPass VPS / staging ###
